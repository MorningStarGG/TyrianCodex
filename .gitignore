# CMake build tree (out-of-source; also holds FetchContent's _deps: nexus-api, imgui, json)
/build/

# Private data-generation pipeline -- its own (private) repository, not part of this one
/builder/

# Local-only browsable archive of the pre-split git history (see history/README.md)
/history/

# Runtime image cache (downloaded tiles/icons live in the addon dir, never in source)
cache/
*.cache

# Optional Pathing-comparison pack (build_taco.py output; not bundled)
data/packs/

# Loose pack SOURCE dirs -- build inputs for data/textures/{items,tiles}.pack (build_texpacks.py). Only the
# .pack files ship/commit; the loose sources are regenerated by the builder (refresh_bundle re-pulls + re-packs
# them on a version bump). build_assets.py downloads here, build_texpacks.py packs them, then they're removed.
data/textures/tiles/
data/textures/items/
data/textures/maps/
data/textures/portraits/
data/textures/decorations/
data/textures/cats/
data/textures/skins/
data/textures/cosmetic_icons/
data/textures/cosmetic_renders/
data/textures/loading/

# Build output / linker artifacts (the DLL deploys to the Nexus addons folder; never tracked)
*.dll
*.exp
*.lib
*.pdb
*.ilk

# MSVC / Visual Studio
.vs/
*.user
*.suo
CMakeUserPresets.json

# Editors
.vscode/
.idea/

# Python caches (if the builder is ever run in-tree)
__pycache__/
*.pyc

# Conversation transcripts / local-only assistant files
*.jsonl
CLAUDE.md
.claude/
